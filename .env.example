# Copie para .env e ajuste se precisar:  cp .env.example .env
# O .env é lido pelo docker compose e também pela aplicação quando roda fora do contêiner
# (spring.config.import em application.yml). Ele não é versionado.
# Todos os valores abaixo são os padrões de desenvolvimento; sem .env o projeto roda igual.

# ---------- Banco de dados (PostgreSQL) ----------
DB_NAME=activation
DB_USER=activation
DB_PASSWORD=activation
# Usada só quando a aplicação roda fora do contêiner (./mvnw spring-boot:run).
DB_URL=jdbc:postgresql://localhost:5432/activation

# ---------- Aplicação ----------
SERVER_PORT=8080

# ---------- Provedor externo de ativação ----------
# Fora do contêiner aponta para o mock do compose publicado na porta 8089.
PROVIDER_BASE_URL=http://localhost:8089
# Em produção vem de um cofre de segredos; nunca versione um valor real.
PROVIDER_API_KEY=local-dev-key
PROVIDER_CONNECT_TIMEOUT=2s
PROVIDER_READ_TIMEOUT=5s

# ---------- Processamento assíncrono ----------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2s
WORKER_RECONCILE_INTERVAL=1m

# ---------- Segurança (OAuth 2.0 / JWT) ----------
# Emissor esperado no claim "iss" (o Keycloak do compose, acessado pelo host).
OAUTH_ISSUER=http://localhost:8180/realms/activation
# Onde a aplicação busca as chaves públicas. Fora do contêiner é o mesmo host do emissor.
OAUTH_JWK_SET_URI=http://localhost:8180/realms/activation/protocol/openid-connect/certs
OAUTH_AUDIENCE=activation-service

# ---------- Desligamento ----------
SHUTDOWN_TIMEOUT=30s
