{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/provider/v1/activate",
    "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /.*ERROR.*/)]" }]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "INTERNAL_ERROR" }
  }
}
